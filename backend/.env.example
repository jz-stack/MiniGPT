# ========== LLM 对话模型（OpenAI 兼容接口）==========
# DeepSeek：baseUrl=https://api.deepseek.com/v1  model=deepseek-chat
# 硅基流动 SiliconFlow：baseUrl=https://api.siliconflow.cn/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=deepseek-chat

# ========== Embedding 向量模型（OpenAI 兼容接口）==========
# 硅基流动免费推荐：bge-m3（1024维）或 BAAI/bge-large-zh-v1.5（1024维）
# OpenAI：model=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=BAAI/bge-m3

# ========== RAG 参数 ==========
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4

# ========== 服务与安全 ==========
PORT=8000
# 监听地址。默认只监听本机回环，避免服务被局域网/公网访问（本服务不含鉴权）
# 需要局域网访问时改成 0.0.0.0，并确保网络环境可信
HOST=127.0.0.1
# 允许跨域访问本服务的来源白名单（逗号分隔）。写操作会校验 Origin
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# 数据目录，默认 backend/data。回归测试用独立目录，避免污染开发库
# DATA_DIR=
# 模型 baseUrl 的域名白名单（逗号分隔）。留空则不限制，只强制 http/https
# ALLOWED_MODEL_HOSTS=api.deepseek.com,api.siliconflow.cn

# ========== 输入上限 ==========
# 单条提问最大字符数
MAX_MESSAGE_CHARS=8000
# 单个文档解析出的纯文本上限
MAX_DOC_CHARS=5000000
# 同时处理的文档数上限（超出的上传请求返回 429）
MAX_CONCURRENT_PARSING=3
# 检索 Top-K 上限
MAX_TOP_K=50
# 相似度阈值，低于该值的片段不注入 Prompt
MIN_SCORE=0.3

# ========== 上游超时（毫秒）==========
EMBEDDING_TIMEOUT_MS=30000
LLM_TIMEOUT_MS=120000
